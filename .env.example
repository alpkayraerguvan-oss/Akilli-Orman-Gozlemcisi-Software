# Public (tarayıcıya gider). service_role veya veritabanı şifresini buraya koyma.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_NTFY_TOPIC=
VITE_STATION_ID=AOG-DEMO-1
VITE_CLERK_PUBLISHABLE_KEY=

# Pi yerel PostgREST: http://192.168.68.61:8000
# Vite `npm run dev` bu adresi /rest üzerinden vekiller; tarayıcı 127.0.0.1 görür.
# Vercel HTTPS sayfası HTTP Pi'ye gidemez; tünel (HTTPS) gerekir.

# Asistan aynı sitededir (/asistan). Bu adres tarayıcıya gitmez; Vite /v1 vekilidir.
# VITE_PI_CHAT_URL kullanma — tarayıcı paketine girer.
PI_CHAT_URL=http://127.0.0.1:8080

# Pi chat_proxy CORS. Boş bırakılırsa Vercel PWA + yerel Vite.
# CHAT_CORS_ORIGIN=https://akilli-orman-gozlemcisi-software.vercel.app,http://localhost:5173

# Yalnız seed / alıcı. VITE_ öneki kullanma. Clerk secret buraya da VITE_ ile koyma.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk production FAPI vekili (/__clerk). Secret tarayıcıya gitmez.
CLERK_SECRET_KEY=
VITE_CLERK_PROXY_URL=/__clerk
