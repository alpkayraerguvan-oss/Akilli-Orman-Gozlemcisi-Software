# Copy to pi/supabase/.env and fill with real random values.
# Never commit the real .env (already covered by the root .gitignore).
#
# Generate strong values, e.g.:
#   AOG_JWT_SECRET:              openssl rand -base64 48
#   AOG_PG_PASSWORD / AOG_AUTHENTICATOR_PASSWORD: openssl rand -hex 24

AOG_PG_PASSWORD=
AOG_AUTHENTICATOR_PASSWORD=
AOG_JWT_SECRET=
